{
  "name": "pokemmocompendium",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://pokemmo-compendium.web.app/",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc -b --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "preview": "vite preview",
    "format": "prettier --write --cache \"**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "format:check": "prettier --check --cache \"**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:style": "stylelint \"src/**/*.css\" --cache",
    "lint:style:fix": "stylelint \"src/**/*.css\" --cache --fix",
    "fix:all": "pnpm run format && pnpm run lint:fix && pnpm run lint:style:fix",
    "validate": "NODE_OPTIONS='--pending-deprecation' pnpm run type-check && pnpm run lint && pnpm run lint:style && pnpm run format:check && pnpm run validate:data && pnpm run validate:rules && pnpm run check:summary-size && pnpm run test:domain",
    "test": "vitest",
    "test:run": "vitest run",
    "test:domain": "vitest run --config vitest.config.domain.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm run type-check && vite build",
    "validate:data": "tsx --tsconfig ./tsconfig.app.json scripts/validateGameData.ts",
    "validate:rules": "tsx --tsconfig ./tsconfig.app.json scripts/validateFirestoreRules.ts",
    "check:summary-size": "tsx --tsconfig ./tsconfig.app.json scripts/checkPokedexSummarySize.ts",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write --cache"
    ],
    "*.css": [
      "stylelint --cache --fix",
      "prettier --write --cache"
    ],
    "*.{json,md}": [
      "prettier --write --cache"
    ]
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.33.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.2",
    "firebase": "12.11.0",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.14.0",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/ui": "4.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^4.10.2",
    "globals": "17.4.0",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "7.3.1",
    "vitest": "4.1.2"
  }
}
